# Database
DATABASE_URL=sqlite:///./keeladi.db

# Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_here_for_development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Application
API_V1_STR=/api/v1
PROJECT_NAME="KEELADI Smart Civic Operations Platform"

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# File Uploads
UPLOAD_DIR=./uploads

# Geo-Verification
MAX_GEO_DISTANCE_METERS=100
